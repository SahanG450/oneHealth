{
  "name": "onehealth",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:mobile": "npm run start -w apps/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate:api": "node scripts/generate-api-client.js"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@onehealth/mobile": {
      "react": "18.2.0"
    }
  }
}
