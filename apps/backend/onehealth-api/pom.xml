<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>lk.onehealth</groupId>
    <artifactId>onehealth-backend</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>onehealth-api</artifactId>

  <properties>
    <start-class>lk.onehealth.api.OneHealthApiApplication</start-class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>lk.onehealth.api.OneHealthApiApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
