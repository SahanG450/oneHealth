{
  "expo": {
    "name": "OneHealth",
    "slug": "onehealth",
    "scheme": "onehealth",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.onehealth.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "lk.onehealth.app"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-auth-session",
        {
          "scheme": "onehealth"
        }
      ]
    ]
  }
}
